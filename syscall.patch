diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index cd25557..e174a5f 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -110,3 +110,22 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+uint64
+sys_interpose(void)
+{
+  int mask;
+  struct proc *p = myproc();
+
+  if (p->is_interposed)
+    return -1;
+
+  argint(0, &mask);
+  if (argstr(1, p->interpose_path, MAXPATH) < 0) {
+    p->interpose_path[0] = '\0';
+    return -1;
+  }
+  p->interpose_mask = mask;
+  p->is_interposed = 1;
+
+  return 0;
+}
